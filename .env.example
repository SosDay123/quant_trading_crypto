# OKX API 配置
# 在 https://www.okx.com/account/my-api 创建 API 密钥
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# 是否使用模拟盘 (true = 模拟盘, false = 实盘)
OKX_DEMO=true

# 交易参数
INITIAL_CAPITAL=100
TRADE_PAIR=BTC-USDT
CANDLE_INTERVAL=15m

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
